<?xml version="1.0" encoding="utf-8"?>
<!--
  The score leads, at the size a score deserves; everything that explains it follows in grouped
  cards. The old screen put the headline, the number and the detail line in the accent colour,
  a bordered level box and then a bare column of rows with no card around them at all.
-->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg"
    android:fitsSystemWindows="true"
    android:overScrollMode="never"
    android:scrollbars="none">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingHorizontal="@dimen/screen_margin"
        android:paddingTop="@dimen/space_6"
        android:paddingBottom="@dimen/space_6">

        <TextView
            android:id="@+id/headline"
            style="@style/Cindy.Eyebrow"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="TIME" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:baselineAligned="true"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/score"
                style="@style/Cindy.MetricXL"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textSize="72sp"
                android:text="0" />

            <!-- Rounds are the score; the loose reps are a footnote on it. -->
            <TextView
                android:id="@+id/scoreReps"
                style="@style/Cindy.MetricXL"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:fontFamily="@font/manrope_bold"
                android:textColor="@color/label_tertiary"
                android:textSize="38sp"
                android:visibility="gone" />
        </LinearLayout>

        <TextView
            android:id="@+id/scoreDetail"
            style="@style/Cindy.Callout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp" />

        <!-- What this session earned, when it earned anything. Built in code. -->
        <LinearLayout
            android:id="@+id/celebration"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_6"
            android:background="@drawable/glass_card"
            android:orientation="vertical"
            android:paddingHorizontal="20dp"
            android:paddingVertical="16dp"
            android:visibility="gone" />

        <!-- ── the rung, and what the next one costs ── -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_6"
            android:background="@drawable/glass_card"
            android:orientation="vertical"
            android:paddingHorizontal="20dp"
            android:paddingTop="18dp"
            android:paddingBottom="20dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:baselineAligned="true"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/levelTitle"
                    style="@style/Cindy.Title2"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1" />

                <TextView
                    android:id="@+id/levelRung"
                    style="@style/Cindy.Footnote"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content" />
            </LinearLayout>

            <TextView
                android:id="@+id/levelBlurb"
                style="@style/Cindy.Footnote"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="5dp"
                android:textColor="@color/label_secondary"
                android:textSize="13sp" />

            <ProgressBar
                android:id="@+id/levelProgress"
                style="?android:attr/progressBarStyleHorizontal"
                android:layout_width="match_parent"
                android:layout_height="5dp"
                android:layout_marginTop="16dp"
                android:max="100"
                android:progressDrawable="@drawable/track" />

            <TextView
                android:id="@+id/levelNext"
                style="@style/Cindy.Footnote"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp" />
        </LinearLayout>

        <TextView
            android:id="@+id/compareTitle"
            style="@style/Cindy.Eyebrow"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_6"
            android:layout_marginBottom="10dp"
            android:layout_marginStart="4dp"
            android:text="COMPARED WITH"
            android:visibility="gone" />

        <LinearLayout
            android:id="@+id/compare"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="gone" />

        <TextView
            android:id="@+id/statsTitle"
            style="@style/Cindy.Eyebrow"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_6"
            android:layout_marginBottom="10dp"
            android:layout_marginStart="4dp"
            android:text="SESSION" />

        <LinearLayout
            android:id="@+id/stats"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical" />

        <TextView
            android:id="@+id/movementsTitle"
            style="@style/Cindy.Eyebrow"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_6"
            android:layout_marginBottom="10dp"
            android:layout_marginStart="4dp"
            android:text="MOVEMENTS"
            android:visibility="gone" />

        <LinearLayout
            android:id="@+id/movements"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="gone" />

        <TextView
            android:id="@+id/splitsTitle"
            style="@style/Cindy.Eyebrow"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_6"
            android:layout_marginBottom="12dp"
            android:layout_marginStart="4dp"
            android:text="ROUND SPLITS" />

        <com.cindy.tracker.SplitsChartView
            android:id="@+id/splits"
            android:layout_width="match_parent"
            android:layout_height="182dp"
            android:background="@drawable/glass_card"
            android:padding="16dp" />

        <TextView
            android:id="@+id/splitsNote"
            style="@style/Cindy.Footnote"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:layout_marginStart="4dp" />

        <LinearLayout
            android:id="@+id/actions"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal" />
    </LinearLayout>
</ScrollView>
