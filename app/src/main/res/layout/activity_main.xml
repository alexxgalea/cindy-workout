<?xml version="1.0" encoding="utf-8"?>
<!--
  The camera runs edge to edge; the HUD is kept clear of the system bars from code, because
  padding this root would letterbox the preview instead of the overlay.
-->
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg">

    <androidx.camera.view.PreviewView
        android:id="@+id/preview"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <com.cindy.tracker.OverlayView
        android:id="@+id/overlay"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintTop_toTopOf="@id/preview"
        app:layout_constraintBottom_toBottomOf="@id/preview"
        app:layout_constraintStart_toStartOf="@id/preview"
        app:layout_constraintEnd_toEndOf="@id/preview" />

    <!-- ── top row: clock + round ── -->
    <TextView
        android:id="@+id/timer"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="8dp"
        android:background="@drawable/bg_chip"
        android:paddingHorizontal="18dp"
        android:paddingVertical="6dp"
        android:fontFamily="monospace"
        android:maxLines="1"
        android:text="20:00"
        android:textColor="@color/on_surface"
        android:textSize="34sp"
        android:textStyle="bold"
        app:autoSizeMaxTextSize="34sp"
        app:autoSizeMinTextSize="20sp"
        app:autoSizeTextType="uniform"
        app:layout_constraintWidth_default="wrap"
        app:layout_constraintHorizontal_bias="0"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toStartOf="@id/rounds" />

    <TextView
        android:id="@+id/rounds"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:layout_marginEnd="16dp"
        android:background="@drawable/bg_chip"
        android:maxLines="1"
        android:paddingHorizontal="18dp"
        android:paddingVertical="6dp"
        android:text="ROUND 1"
        android:textColor="@color/on_surface"
        android:textSize="16sp"
        android:textStyle="bold"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />


    <!--
      Below the taller of the timer and round chips, not just round: the timer's 34sp text makes
      it deeper than ROUND 1's 16sp, so anchoring to round alone let the chip row ride up under it.
    -->
    <androidx.constraintlayout.widget.Barrier
        android:id="@+id/topRowBottom"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:barrierDirection="bottom"
        app:constraint_referenced_ids="timer,rounds" />

    <!-- ── voice / music / records toggles ── -->
    <LinearLayout
        android:id="@+id/chips"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:layout_marginEnd="16dp"
        android:orientation="horizontal"
        app:layout_constraintTop_toBottomOf="@id/topRowBottom"
        app:layout_constraintEnd_toEndOf="parent">

        <TextView
            android:id="@+id/btnVoice"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="6dp"
            android:background="@drawable/bg_chip_tappable"
            android:gravity="center"
            android:maxLines="1"
            android:minWidth="48dp"
            android:minHeight="48dp"
            android:paddingHorizontal="12dp"
            android:text="VOICE"
            android:textColor="@color/accent"
            android:textSize="11sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/btnMusic"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="6dp"
            android:background="@drawable/bg_chip_tappable"
            android:gravity="center"
            android:maxLines="1"
            android:minWidth="48dp"
            android:minHeight="48dp"
            android:paddingHorizontal="12dp"
            android:text="MUSIC"
            android:textColor="@color/on_surface_dim"
            android:textSize="11sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/btnRec"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="6dp"
            android:background="@drawable/bg_chip_tappable"
            android:gravity="center"
            android:maxLines="1"
            android:minWidth="48dp"
            android:minHeight="48dp"
            android:paddingHorizontal="12dp"
            android:text="REC"
            android:textColor="@color/on_surface_dim"
            android:textSize="11sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/btnRecords"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="6dp"
            android:background="@drawable/bg_chip_tappable"
            android:gravity="center"
            android:maxLines="1"
            android:minWidth="48dp"
            android:minHeight="48dp"
            android:paddingHorizontal="12dp"
            android:text="RECORDS"
            android:textColor="@color/on_surface_dim"
            android:textSize="11sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/btnHelp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="6dp"
            android:background="@drawable/bg_chip_tappable"
            android:gravity="center"
            android:maxLines="1"
            android:minWidth="48dp"
            android:minHeight="48dp"
            android:paddingHorizontal="12dp"
            android:text="HELP"
            android:textColor="@color/on_surface_dim"
            android:textSize="11sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- ── status / coaching line ── -->
    <TextView
        android:id="@+id/status"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="16dp"
        android:background="@drawable/bg_chip"
        android:gravity="center"
        android:paddingHorizontal="14dp"
        android:paddingVertical="6dp"
        android:text="Grant camera access to begin"
        android:textColor="@color/on_surface_dim"
        android:textSize="14sp"
        app:layout_constraintTop_toBottomOf="@id/chips"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- ── the big rep readout ── -->
    <LinearLayout
        android:id="@+id/repBlock"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginBottom="18dp"
        android:layout_marginHorizontal="16dp"
        android:background="@drawable/bg_chip"
        android:gravity="center"
        android:orientation="vertical"
        android:paddingHorizontal="34dp"
        android:paddingVertical="10dp"
        app:layout_constrainedWidth="true"
        app:layout_constraintWidth_default="wrap"
        app:layout_constraintBottom_toTopOf="@id/controls"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <TextView
            android:id="@+id/exercise"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:letterSpacing="0.15"
            android:maxLines="1"
            android:text="PULL-UPS"
            android:textColor="@color/accent"
            android:textSize="20sp"
            android:textStyle="bold"
            app:autoSizeMaxTextSize="20sp"
            app:autoSizeMinTextSize="13sp"
            app:autoSizeTextType="uniform" />

        <TextView
            android:id="@+id/reps"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:fontFamily="monospace"
            android:gravity="center"
            android:maxLines="1"
            android:text="0 / 5"
            android:textColor="@color/on_surface"
            android:textSize="64sp"
            android:textStyle="bold"
            app:autoSizeMaxTextSize="64sp"
            app:autoSizeMinTextSize="30sp"
            app:autoSizeTextType="uniform" />
    </LinearLayout>

    <!-- ── controls ── -->
    <LinearLayout
        android:id="@+id/controls"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="24dp"
        android:layout_marginHorizontal="16dp"
        android:gravity="center"
        android:orientation="horizontal"
        app:layout_constraintBottom_toBottomOf="parent">

        <TextView
            android:id="@+id/btnFlip"
            android:layout_width="wrap_content"
            android:layout_height="56dp"
            android:background="@drawable/bg_button_ghost"
            android:gravity="center"
            android:maxLines="1"
            android:minWidth="56dp"
            android:paddingHorizontal="18dp"
            android:text="FLIP"
            android:textColor="@color/on_surface"
            android:textSize="15sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/btnStart"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="56dp"
            android:layout_marginHorizontal="8dp"
            android:background="@drawable/bg_button"
            android:gravity="center"
            android:maxLines="1"
            android:minWidth="88dp"
            android:text="START"
            android:textColor="#0B0D10"
            android:textSize="18sp"
            android:textStyle="bold"
            app:autoSizeMaxTextSize="18sp"
            app:autoSizeMinTextSize="12sp"
            app:autoSizeTextType="uniform" />

        <TextView
            android:id="@+id/btnUndo"
            android:layout_width="wrap_content"
            android:layout_height="56dp"
            android:layout_marginEnd="8dp"
            android:background="@drawable/bg_button_ghost"
            android:gravity="center"
            android:maxLines="1"
            android:minWidth="56dp"
            android:paddingHorizontal="18dp"
            android:text="−1"
            android:textColor="@color/on_surface"
            android:textSize="18sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/btnSkip"
            android:layout_width="wrap_content"
            android:layout_height="56dp"
            android:background="@drawable/bg_button_ghost"
            android:gravity="center"
            android:maxLines="1"
            android:minWidth="56dp"
            android:paddingHorizontal="18dp"
            android:text="+1"
            android:textColor="@color/on_surface"
            android:textSize="18sp"
            android:textStyle="bold" />
    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
