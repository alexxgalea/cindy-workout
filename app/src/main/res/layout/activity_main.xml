<?xml version="1.0" encoding="utf-8"?>
<!--
  The camera runs edge to edge; the HUD is kept clear of the cutout from code, because padding
  this root would letterbox the preview instead of the overlay.

  The HUD is no longer a set of cards floating on the picture. It is the two bands at the edges
  of it, the way a camera app does it: everything the athlete can touch lives in a band, and the
  bright middle is left alone for the body. The bands are translucent, so the picture carries on
  underneath and a foot that has drifted low is still visible — dimmed, but there.

  Two surfaces, then, where there were four. The clock bar and the icon rail are one band; the
  status line joins them rather than floating beneath; the rep panel is the other band, with the
  progress bar as the band's own top edge, which is both one row less and a boundary you can see.
-->
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg">

    <androidx.camera.view.PreviewView
        android:id="@+id/preview"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <com.cindy.tracker.OverlayView
        android:id="@+id/overlay"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintTop_toTopOf="@id/preview"
        app:layout_constraintBottom_toBottomOf="@id/preview"
        app:layout_constraintStart_toStartOf="@id/preview"
        app:layout_constraintEnd_toEndOf="@id/preview" />

    <!--
      ── the top band: the clock, what changes mid-set, and the coaching line ──

      Height is whatever its rows need, so a large font scale grows the band rather than clipping
      it. The system bars are hidden on this screen, so the only thing pushing the first row down
      is the camera cutout, applied as padding from code.
    -->
    <LinearLayout
        android:id="@+id/bandTop"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:background="@color/band_top"
        android:orientation="vertical"
        android:paddingTop="14dp"
        android:paddingBottom="11dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="20dp"
            android:paddingEnd="12dp">

            <TextView
                android:id="@+id/timer"
                style="@style/Cindy.MetricM"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="20:00"
                app:autoSizeMaxTextSize="30sp"
                app:autoSizeMinTextSize="20sp"
                app:autoSizeTextType="uniform" />

            <!--
              Icons, not words: four labelled chips wanted 330dp of row and this one has 320.
              Two of them now. Music went to the menu, where the track can be chosen with a tap
              rather than found behind a long press, and the voice followed it there — it is a
              switch and a volume, which only read as one setting when they sit together, and
              neither is an adjustment anyone makes between two pull-ups. REC stays: it carries
              live state the athlete changes mid-session, which is the whole test for this row.
            -->
            <ImageView
                android:id="@+id/btnRec"
                android:layout_width="44dp"
                android:layout_height="40dp"
                android:padding="11dp"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_rec"
                tools:ignore="ContentDescription" />

            <ImageView
                android:id="@+id/btnMenu"
                android:layout_width="44dp"
                android:layout_height="40dp"
                android:padding="11dp"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_menu"
                tools:ignore="ContentDescription" />
        </LinearLayout>

        <!-- The coaching line. It sat in a pill over the athlete; on the band it needs no pill. -->
        <LinearLayout
            android:id="@+id/statusRow"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:gravity="center"
            android:minHeight="22dp"
            android:orientation="horizontal"
            android:paddingHorizontal="20dp">

            <View
                android:id="@+id/statusDot"
                android:layout_width="7dp"
                android:layout_height="7dp"
                android:layout_marginEnd="8dp"
                android:importantForAccessibility="no" />

            <TextView
                android:id="@+id/status"
                style="@style/Cindy.Headline"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:maxLines="1"
                android:text="Grant camera access to begin"
                android:textSize="14sp" />
        </LinearLayout>
    </LinearLayout>

    <!--
      ── the start-position demonstrator ──

      The one thing still allowed to stand on the picture, because it shows before a set rather
      than during one, and because it is the status line grown up: while it is showing, that line
      hides, so the cue is never given twice.
    -->
    <LinearLayout
        android:id="@+id/coachCard"
        android:layout_width="132dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/screen_margin"
        android:layout_marginTop="20dp"
        android:background="@drawable/glass_panel"
        android:orientation="vertical"
        android:paddingHorizontal="10dp"
        android:paddingVertical="12dp"
        android:visibility="gone"
        app:layout_constraintTop_toBottomOf="@id/bandTop"
        app:layout_constraintStart_toStartOf="parent">

<!--
          No caption. A figure walking into a hang, over the words "Hang from the bar", does not
          also need to be labelled "start position" — and at 132dp wide the label only fitted at
          9sp, which is below the size anything should be set in.
        -->
        <com.cindy.tracker.StartPoseView
            android:id="@+id/coachPose"
            android:layout_width="match_parent"
            android:layout_height="126dp"
            android:importantForAccessibility="no" />

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginTop="10dp"
            android:background="@color/hairline"
            android:importantForAccessibility="no" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:gravity="center"
            android:orientation="horizontal">

            <View
                android:id="@+id/coachDot"
                android:layout_width="6dp"
                android:layout_height="6dp"
                android:layout_marginEnd="7dp"
                android:importantForAccessibility="no" />

            <TextView
                android:id="@+id/coachCue"
                style="@style/Cindy.Headline"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textSize="12.5sp" />
        </LinearLayout>
    </LinearLayout>

    <!-- ══ the bottom band: the metric and everything that acts on it ══ -->
    <LinearLayout
        android:id="@+id/bandBottom"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:background="@color/band_bottom"
        android:orientation="vertical"
        android:paddingBottom="16dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <!--
          Edge to edge, and it is the band's own top edge: readable from across the room when the
          digits are not, and it draws the line the picture ends on.
        -->
        <ProgressBar
            android:id="@+id/repProgress"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent"
            android:layout_height="3dp"
            android:importantForAccessibility="no"
            android:max="100"
            android:progressDrawable="@drawable/track" />

        <!-- The round moved down off the clock bar: 72 + 55 + 176dp of row against 320 available. -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:baselineAligned="true"
            android:orientation="horizontal"
            android:paddingHorizontal="20dp">

            <TextView
                android:id="@+id/roundsLabel"
                style="@style/Cindy.Eyebrow"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:importantForAccessibility="no"
                android:text="ROUND" />

            <TextView
                android:id="@+id/rounds"
                style="@style/Cindy.Eyebrow"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:layout_weight="1"
                android:fontFeatureSettings="tnum"
                android:text="1"
                android:textColor="@color/label_secondary" />

            <TextView
                android:id="@+id/exercise"
                style="@style/Cindy.Eyebrow"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="end"
                android:text="PULL-UPS"
                android:textColor="@color/label_secondary"
                app:autoSizeMaxTextSize="11sp"
                app:autoSizeMinTextSize="8sp"
                app:autoSizeTextType="uniform" />
        </LinearLayout>

        <!-- Rep edits sit either side of the number they change, not lost among the actions. -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="20dp">

            <ImageView
                android:id="@+id/btnUndo"
                android:layout_width="52dp"
                android:layout_height="52dp"
                android:background="@drawable/btn_glass"
                android:padding="15dp"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_minus"
                tools:ignore="ContentDescription" />

            <LinearLayout
                android:id="@+id/repBlock"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="10dp"
                android:layout_weight="1"
                android:baselineAligned="true"
                android:gravity="center"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/reps"
                    style="@style/Cindy.MetricXL"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="0"
                    android:textSize="56sp"
                    app:autoSizeMaxTextSize="56sp"
                    app:autoSizeMinTextSize="30sp"
                    app:autoSizeTextType="uniform" />

                <!-- Drops back a weight and a shade so the eye lands on the number that moves. -->
                <TextView
                    android:id="@+id/repsTarget"
                    style="@style/Cindy.MetricXL"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/manrope_bold"
                    android:text="/5"
                    android:textColor="@color/label_tertiary"
                    android:textSize="30sp" />
            </LinearLayout>

            <ImageView
                android:id="@+id/btnAddRep"
                android:layout_width="52dp"
                android:layout_height="52dp"
                android:background="@drawable/btn_glass"
                android:padding="15dp"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_plus"
                tools:ignore="ContentDescription" />
        </LinearLayout>

        <!--
          The action row, laid out the way a camera lays one out: the shutter dead centre of the
          screen with a satellite parked at a fixed inset from either edge, rather than hung off
          the shutter, so the middle of the band stays the middle at any width.

          The primary carries a mark and no word. Play, pause, again — the states it takes are
          ones a player already draws, and the word it used to hold forced a pill wide enough for
          the longest label, which is most of what made this band feel crowded. The status line
          above narrates the state, and the spoken description names the action for anyone who
          cannot see the mark.

          SKIP is its own control on the right and is there in every state, because it means one
          thing — leave this movement — and a control that means one thing should not be a long
          press on a control that means another.

          The left slot holds one control at a time: FLIP until the clock starts, END in red once
          it has. They are two views sharing a position rather than one view swapping its icon,
          so each keeps its own mark, tint and spoken name. Carrying both at once was tried and
          the band was too crowded — and a camera flip is not something anyone reaches for
          mid-Cindy, while a way out of the workout is.
        -->
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="@dimen/shutter"
            android:layout_marginTop="12dp"
            android:paddingHorizontal="20dp">

            <ImageView
                android:id="@+id/btnFlip"
                android:layout_width="52dp"
                android:layout_height="52dp"
                android:layout_gravity="start|center_vertical"
                android:background="@drawable/btn_glass"
                android:padding="14dp"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_flip"
                tools:ignore="ContentDescription" />

            <!-- Stacked on FLIP, which is gone by the time this is here. -->
            <ImageView
                android:id="@+id/btnEnd"
                android:layout_width="52dp"
                android:layout_height="52dp"
                android:layout_gravity="start|center_vertical"
                android:background="@drawable/btn_glass"
                android:padding="15dp"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_stop"
                tools:ignore="ContentDescription" />

            <ImageView
                android:id="@+id/btnStart"
                android:layout_width="@dimen/shutter"
                android:layout_height="@dimen/shutter"
                android:layout_gravity="center"
                android:background="@drawable/btn_shutter"
                android:padding="19dp"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_play"
                tools:ignore="ContentDescription" />

            <ImageView
                android:id="@+id/btnSkipExercise"
                android:layout_width="52dp"
                android:layout_height="52dp"
                android:layout_gravity="end|center_vertical"
                android:background="@drawable/btn_glass"
                android:padding="14dp"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_skip"
                tools:ignore="ContentDescription" />
        </FrameLayout>
    </LinearLayout>

    <!--
      ── the record countdown ──

      Constrained to the picture rather than the whole screen: it belongs in the bright middle
      with the athlete, and a ring centred on the window instead of on the frame would sit low,
      behind the rep panel. Gone until REC is tapped.
    -->
    <com.cindy.tracker.CountdownView
        android:id="@+id/countdown"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:visibility="gone"
        app:layout_constraintTop_toBottomOf="@id/bandTop"
        app:layout_constraintBottom_toTopOf="@id/bandBottom"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!--
      ── the first-launch tour ──

      Over the HUD it points at, and under the launch view, which covers it until the camera is up.
      Gone until the tour is started; while it is showing it takes every touch.
    -->
    <com.cindy.tracker.SpotlightView
        android:id="@+id/spotlight"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:visibility="gone"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Over everything, and gone as soon as the preview has a frame. -->
    <com.cindy.tracker.LaunchView
        android:id="@+id/launch"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>
