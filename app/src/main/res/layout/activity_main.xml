<?xml version="1.0" encoding="utf-8"?>
<!--
  The camera runs edge to edge; the HUD is kept clear of the cutout from code, because padding
  this root would letterbox the preview instead of the overlay.

  The HUD is the two bands at the edges of the picture, the way a camera app does it:
  everything the athlete can touch lives in a band, and the bright middle is left alone for the
  body. The bands are translucent, so the picture carries on underneath and a foot that has
  drifted low is still visible — dimmed, but there.

  The top band is one 48dp row under the cutout. The coaching line is not in a band: it is a
  glass pill on the picture, 8dp under the top band. The rep panel is the other band, with the
  progress bar as the band's own top edge, which is a boundary you can see.

  The bottom band is a scoreboard the athlete can read from the bar, 2 to 3m away: the count and
  its target as one 96sp figure, the movement and round under it on one line, − and + in a glass
  capsule beside the figure, and the controls in a quiet row of 48dp targets.

  That is how it is drawn while the clock runs, which is how this file leaves it. In idle, setup
  and a pause the athlete is at the phone, and BottomBand redraws the same views for that: the
  figure at 56sp with the line under it in the same 96dp zone, a 72dp shutter, 56dp END and
  SKIP, and a row of names under them. The band is 219dp either way.
-->
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg">

    <androidx.camera.view.PreviewView
        android:id="@+id/preview"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <com.cindy.tracker.OverlayView
        android:id="@+id/overlay"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintTop_toTopOf="@id/preview"
        app:layout_constraintBottom_toBottomOf="@id/preview"
        app:layout_constraintStart_toStartOf="@id/preview"
        app:layout_constraintEnd_toEndOf="@id/preview" />

    <!--
      ── the top band: one row, and nothing else ──

      The clock at the start edge; the camera switch, REC and MENU at the end edge. The band is
      the cutout and this 48dp row, so the only thing above the row is the inset, applied as
      padding from code. The coaching line is not in it: it is the pill below, on the picture.
    -->
    <LinearLayout
        android:id="@+id/bandTop"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:background="@color/band_top"
        android:orientation="vertical"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="20dp"
            android:paddingEnd="8dp">

            <TextView
                android:id="@+id/timer"
                style="@style/Cindy.MetricM"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="20:00"
                app:autoSizeMaxTextSize="30sp"
                app:autoSizeMinTextSize="20sp"
                app:autoSizeTextType="uniform" />

            <!--
              The camera switch. It lives with the other things that are about the camera rather
              than the count, beside REC and MENU, and not in the left slot of the action row:
              that slot is END's alone while a workout is live, and the switch has to stay on the
              screen, dimmed, while the clock runs.

              Each of the three is a 48dp touch target with a 24dp glyph. The names here are the
              ones a screen reader gets before the activity sets the state-dependent ones.
            -->
            <ImageView
                android:id="@+id/btnFlip"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:contentDescription="Switch camera"
                android:padding="12dp"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_flip" />

            <!--
              Icons, not words. Music went to the menu, where the track can be chosen with a tap
              rather than found behind a long press, and the voice followed it there. REC stays: it
              carries live state the athlete changes mid-session, which is the whole test for this
              row.
            -->
            <ImageView
                android:id="@+id/btnRec"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:contentDescription="Record this workout"
                android:padding="12dp"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_rec" />

            <ImageView
                android:id="@+id/btnMenu"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:contentDescription="Menu"
                android:padding="12dp"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_menu" />
        </LinearLayout>
    </LinearLayout>

    <!--
      ── the coaching line ──

      One pill on the picture, in the design system's glass (no blur): the status dot and the
      line. Centred, 8dp under the top band and never closer than 16dp to a screen edge; a line
      too long for one row wraps to a second, centred, rather than being cut at the edge.
    -->
    <LinearLayout
        android:id="@+id/statusRow"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/screen_margin"
        android:layout_marginTop="8dp"
        android:layout_marginEnd="@dimen/screen_margin"
        android:background="@drawable/glass_pill"
        android:gravity="center"
        android:minHeight="34dp"
        android:orientation="horizontal"
        android:paddingHorizontal="16dp"
        android:paddingVertical="8dp"
        app:layout_constrainedWidth="true"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/bandTop">

        <View
            android:id="@+id/statusDot"
            android:layout_width="7dp"
            android:layout_height="7dp"
            android:layout_marginEnd="8dp"
            android:importantForAccessibility="no" />

        <TextView
            android:id="@+id/status"
            style="@style/Cindy.Headline"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:maxLines="2"
            android:text="Grant camera access to begin"
            android:textSize="14sp" />
    </LinearLayout>

    <!--
      ── the start-position demonstrator ──

      The one thing still allowed to stand on the picture, because it shows before a set rather
      than during one, and because it is the status line grown up: while it is showing, that line
      hides, so the cue is never given twice.
    -->
    <LinearLayout
        android:id="@+id/coachCard"
        android:layout_width="132dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/screen_margin"
        android:layout_marginTop="12dp"
        android:background="@drawable/glass_panel"
        android:orientation="vertical"
        android:paddingHorizontal="10dp"
        android:paddingVertical="12dp"
        android:visibility="gone"
        app:layout_constraintTop_toBottomOf="@id/statusRow"
        app:layout_constraintStart_toStartOf="parent">

<!--
          No caption. A figure walking into a hang, over the words "Hang from the bar", does not
          also need to be labelled "start position" — and at 132dp wide the label only fitted at
          9sp, which is below the size anything should be set in.
        -->
        <com.cindy.tracker.StartPoseView
            android:id="@+id/coachPose"
            android:layout_width="match_parent"
            android:layout_height="126dp"
            android:importantForAccessibility="no" />

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginTop="10dp"
            android:background="@color/hairline"
            android:importantForAccessibility="no" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:gravity="center"
            android:orientation="horizontal">

            <View
                android:id="@+id/coachDot"
                android:layout_width="6dp"
                android:layout_height="6dp"
                android:layout_marginEnd="7dp"
                android:importantForAccessibility="no" />

            <TextView
                android:id="@+id/coachCue"
                style="@style/Cindy.Headline"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textSize="12.5sp" />
        </LinearLayout>
    </LinearLayout>

    <!-- ══ the bottom band: the metric and everything that acts on it ══ -->
    <LinearLayout
        android:id="@+id/bandBottom"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:background="@color/band_bottom"
        android:minHeight="219dp"
        android:orientation="vertical"
        android:paddingBottom="12dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <!--
          Edge to edge, and it is the band's own top edge: readable from across the room when the
          digits are not, and it draws the line the picture ends on.
        -->
        <ProgressBar
            android:id="@+id/repProgress"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent"
            android:layout_height="3dp"
            android:importantForAccessibility="no"
            android:max="100"
            android:progressDrawable="@drawable/track" />

        <!--
          The figure and the capsule that edits it. The zone is 96dp tall: the count, a slash and
          the target as one piece of text at 96sp, in the 280dp between 8dp from the start edge
          and 8dp before the capsule, centred, and shrunk to fit rather than cut ("12/15" fits at
          full size). The capsule is + over -, each half a 48dp target, 16dp from the end edge.
          The athlete is 2 to 3m from the phone while the clock runs; this is what they read.
        -->
        <FrameLayout
            android:id="@+id/repBlock"
            android:layout_width="match_parent"
            android:layout_height="96dp"
            android:layout_marginTop="8dp">

            <com.cindy.tracker.FitFigureView
                android:id="@+id/reps"
                style="@style/Cindy.Scoreboard"
                android:layout_width="match_parent"
                android:layout_height="96dp"
                android:layout_marginStart="8dp"
                android:layout_marginEnd="72dp"
                android:gravity="center"
                android:text="0" />

            <LinearLayout
                android:id="@+id/stepper"
                android:layout_width="48dp"
                android:layout_height="96dp"
                android:layout_gravity="end"
                android:layout_marginEnd="16dp"
                android:background="@drawable/glass_capsule"
                android:orientation="vertical">

                <ImageView
                    android:id="@+id/btnAddRep"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:padding="14dp"
                    android:scaleType="fitCenter"
                    android:src="@drawable/ic_plus"
                    tools:ignore="ContentDescription" />

                <ImageView
                    android:id="@+id/btnUndo"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:padding="14dp"
                    android:scaleType="fitCenter"
                    android:src="@drawable/ic_minus"
                    tools:ignore="ContentDescription" />
            </LinearLayout>
        </FrameLayout>

        <!-- The movement and the round, on one line: "Pull-ups · Round 2". -->
        <TextView
            android:id="@+id/movementLine"
            style="@style/Cindy.ScoreLine"
            android:layout_width="match_parent"
            android:layout_height="24dp"
            android:gravity="center"
            android:text="Pull-ups · Round 1" />

        <!--
          The next set, over the figure zone and the line for about 1.5s when the movement changes
          while the clock runs: its target over the movement's name, "10" over "PUSH-UPS", one size,
          two rows, no slash, so it cannot be read as a count. It covers the 120dp of the zone and
          the line, and only the figure's 280dp of width, so the capsule and the control row stay
          where they are and answer. It adds no height: the margin takes back what it is given.
          Gone until a movement changes; see ScoreboardReadout.
        -->
        <LinearLayout
            android:id="@+id/nextSet"
            android:layout_width="match_parent"
            android:layout_height="120dp"
            android:layout_marginStart="8dp"
            android:layout_marginTop="-120dp"
            android:layout_marginEnd="72dp"
            android:gravity="center"
            android:orientation="vertical"
            android:visibility="gone">

            <com.cindy.tracker.FitFigureView
                android:id="@+id/nextSetTarget"
                style="@style/Cindy.NextSet"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:importantForAccessibility="no" />

            <com.cindy.tracker.FitFigureView
                android:id="@+id/nextSetMovement"
                style="@style/Cindy.NextSet"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:importantForAccessibility="no" />
        </LinearLayout>

        <!--
          The control row, a quiet 48dp row: END centred 40dp from the start edge, the shutter in
          the centre, SKIP centred 40dp from the end edge. Each is a 48dp target with its icon and
          no word; the spoken names come from [CameraControls], through renderControls.

          END is alone in the left slot, once a workout is live and empty before it. SKIP is its
          own control in every state, because it means one thing, leave this movement. The camera
          switch lives in the top band, where it stays on the screen, dimmed, while the clock runs.
        -->
        <FrameLayout
            android:id="@+id/controlRow"
            android:layout_width="match_parent"
            android:layout_height="@dimen/shutter"
            android:layout_marginTop="16dp">

            <ImageView
                android:id="@+id/btnEnd"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:layout_gravity="start|center_vertical"
                android:layout_marginStart="16dp"
                android:background="@drawable/btn_glass"
                android:padding="14dp"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_stop"
                tools:ignore="ContentDescription" />

            <ImageView
                android:id="@+id/btnStart"
                android:layout_width="@dimen/shutter"
                android:layout_height="@dimen/shutter"
                android:layout_gravity="center"
                android:background="@drawable/btn_shutter"
                android:padding="14dp"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_play"
                tools:ignore="ContentDescription" />

            <ImageView
                android:id="@+id/btnSkipExercise"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:layout_gravity="end|center_vertical"
                android:layout_marginEnd="16dp"
                android:background="@drawable/btn_glass"
                android:padding="14dp"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_skip"
                tools:ignore="ContentDescription" />
        </FrameLayout>

        <!--
          The names row, there only when the athlete is at the phone (BottomBand): the word under
          each enabled control, or in idle the one line under the shutter. 16dp tall whatever the
          type setting, so it can never grow the band. The names are labels and no stop for a
          screen reader: what TalkBack says for a control is the name CameraControls gives it.
        -->
        <FrameLayout
            android:id="@+id/controlNames"
            android:layout_width="match_parent"
            android:layout_height="16dp"
            android:layout_marginTop="4dp"
            android:visibility="gone">

            <TextView
                android:id="@+id/nameEnd"
                style="@style/Cindy.ControlName"
                android:layout_width="80dp"
                android:layout_height="match_parent"
                android:layout_gravity="start"
                android:text="END"
                android:visibility="gone" />

            <TextView
                android:id="@+id/nameShutter"
                style="@style/Cindy.ControlName"
                android:layout_width="96dp"
                android:layout_height="match_parent"
                android:layout_gravity="center_horizontal"
                android:text="RESUME"
                android:visibility="gone" />

            <TextView
                android:id="@+id/nameSkip"
                style="@style/Cindy.ControlName"
                android:layout_width="80dp"
                android:layout_height="match_parent"
                android:layout_gravity="end"
                android:text="SKIP"
                android:visibility="gone" />

            <TextView
                android:id="@+id/idleLine"
                style="@style/Cindy.IdleLine"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_marginHorizontal="16dp"
                android:visibility="gone" />
        </FrameLayout>
    </LinearLayout>

    <!--
      ── the record countdown ──

      Constrained to the picture rather than the whole screen: it belongs in the bright middle
      with the athlete, and a ring centred on the window instead of on the frame would sit low,
      behind the rep panel. Gone until REC is tapped.
    -->
    <com.cindy.tracker.CountdownView
        android:id="@+id/countdown"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:visibility="gone"
        app:layout_constraintTop_toBottomOf="@id/bandTop"
        app:layout_constraintBottom_toTopOf="@id/bandBottom"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!--
      ── the first-launch tour ──

      Over the HUD it points at, and under the launch view, which covers it until the camera is up.
      Gone until the tour is started; while it is showing it takes every touch.
    -->
    <com.cindy.tracker.SpotlightView
        android:id="@+id/spotlight"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:visibility="gone"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Over everything, and gone as soon as the preview has a frame. -->
    <com.cindy.tracker.LaunchView
        android:id="@+id/launch"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>
