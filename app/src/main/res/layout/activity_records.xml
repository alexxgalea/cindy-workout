<?xml version="1.0" encoding="utf-8"?>
<!--
  The shape every secondary screen shares: a top bar (back and the title), a line saying what the screen
  is, the content, and any real action in the thumb's reach at the bottom. Rows are built in code from
  CindyViews so that Menu, Records, Results and Help cannot drift apart again.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg"
    android:fitsSystemWindows="true"
    android:orientation="vertical"
    android:paddingHorizontal="@dimen/screen_margin"
    android:paddingBottom="@dimen/space_6">

    <com.cindy.tracker.TopBar
        android:id="@+id/topBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:title="Progress" />

    <TextView
        style="@style/Cindy.Body"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="Cindy — AMRAP 20:00" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="@dimen/space_6"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:overScrollMode="never"
        android:scrollbars="none">

        <LinearLayout
            android:id="@+id/rows"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical" />
    </ScrollView>
</LinearLayout>
