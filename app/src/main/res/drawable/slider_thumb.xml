<?xml version="1.0" encoding="utf-8"?>
<!--
  The slider's grip. A filled disc in the primary fill, sized to the 44dp touch target through
  the SeekBar's own padding rather than by growing the drawable, so the track it rides stays the
  same 6dp rule the level meter on the results screen uses.
-->
<shape xmlns:android="http://schemas.android.com/apk/res/android" android:shape="oval">
    <solid android:color="@color/primary_fill" />
    <size android:width="20dp" android:height="20dp" />
</shape>
