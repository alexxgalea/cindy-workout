<?xml version="1.0" encoding="utf-8"?>
<!--
  Manrope, subset to the Latin range and the punctuation this app actually prints, at the five
  weights the type scale uses. Static instances rather than the variable font: android:fontWeight
  on a <font> needs API 26 (fine), but TextView's android:textFontWeight needs 28, so anything
  wanting 500/600/800 references its file directly instead of resolving through this family.

  This family exists for the theme default, where only normal and bold are ever asked for.
-->
<font-family xmlns:android="http://schemas.android.com/apk/res/android">
    <font android:fontStyle="normal" android:fontWeight="400" android:font="@font/manrope_regular" />
    <font android:fontStyle="normal" android:fontWeight="500" android:font="@font/manrope_medium" />
    <font android:fontStyle="normal" android:fontWeight="600" android:font="@font/manrope_semibold" />
    <font android:fontStyle="normal" android:fontWeight="700" android:font="@font/manrope_bold" />
    <font android:fontStyle="normal" android:fontWeight="800" android:font="@font/manrope_extrabold" />
</font-family>
