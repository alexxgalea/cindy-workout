{
  "env": {
    "SUPERPOWERS_DISABLE_TELEMETRY": "1"
  },
  "attribution": {
    "commit": false,
    "pr": false,
    "sessionUrl": true
  },
  "enabledMcpjsonServers": [
    "code-review-graph"
  ],
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/session-start.sh",
            "timeout": 300
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "jq -r \".tool_input.command // \\\"\\\"\" | grep -qE \"assembleDebug|installDebug|assembleRelease\" && { out=\"$(\"${CLAUDE_PROJECT_DIR:-.}/tools/deploy_apk.sh\" 2>&1)\"; [ -n \"$out\" ] && jq -n --arg m \"$out\" \"{systemMessage:\\$m}\"; }; true",
            "timeout": 60,
            "statusMessage": "Deploying APK to the phone's install server"
          }
        ]
      },
      {
        "matcher": "Write|Edit|Bash",
        "hooks": [
          {
            "type": "command",
            "command": "cat >/dev/null || true; [ -f \"$CLAUDE_PROJECT_DIR/.code-review-graph/graph.db\" ] && cd \"$CLAUDE_PROJECT_DIR\" && uvx --from code-review-graph==2.3.9 code-review-graph update --skip-flows >/dev/null 2>&1; exit 0",
            "timeout": 30
          }
        ]
      }
    ]
  }
}
