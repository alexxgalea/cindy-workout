# Android / Gradle
*.iml
.gradle/
.kotlin/
build/
local.properties
.cxx/
captures/
.externalNativeBuild/

# IDE
.idea/
*.hprof

# Keys & secrets — never commit
*.jks
*.keystore
keystore.properties
secrets.properties
*.env

# macOS
.DS_Store

# Swift / SwiftPM
ios/**/.build/
ios/**/.swiftpm/
# Generated by xcodegen from ios/project.yml — regenerate, don't commit
*.xcodeproj
*.xcworkspace

# Large/licensed video-regression datasets and generated reports stay local. Small consented
# local fixtures and keypoint goldens may be committed deliberately.
/tests/fixtures/infiniterep/**
!/tests/fixtures/infiniterep/**/.gitkeep
/tests/fixtures/repcount/**
!/tests/fixtures/repcount/**/.gitkeep
/tests/reports/**
!/tests/reports/.gitkeep

# Third-party clips pulled from YouTube for local regression only. Never committed.
/tests/fixtures/youtube/**
# The manifest is what makes the ignored clips reproducible, so it is tracked.
!/tests/fixtures/youtube/sources.json

# Desktop harness virtualenv and bytecode
.venv/
__pycache__/
*.pyc

# Generated by parity_check.py; trace_jvm.csv is the committed reference.
/tests/parity/trace_py.csv

# Generated by recognition_parity_check.py; recognition_trace_jvm.csv is the committed reference.
/tests/parity/recognition_trace_py.csv

# Generated by freestyle_parity_check.py; freestyle_trace_jvm.csv and freestyle_sets_jvm.csv are the
# committed references. The films dir holds the keypoints of the owner's films (local, never committed)
# and the film traces are written from it.
/tests/parity/freestyle_trace_py.csv
/tests/parity/freestyle_sets_py.csv
/tests/parity/films/
/tests/parity/freestyle_film_*.csv

# Ad-hoc screen recordings from device testing.
/*.mp4

# Upload signing. The keystore and its passwords never enter git.
/keystore.properties
/*.jks

# Strava API credentials. Never committed.
/strava.properties

# Design notes, research briefs and release runbook. Kept locally, never committed. The
# architecture decisions, the glossary and the agent skills' settings are the exception:
# every session needs them.
/docs/*
!/docs/adr/
!/docs/agents/
!/docs/GLOSSARY.md

# Rendered store listing and privacy policy, with the publisher's own details filled in.
/play/dist/
/appstore/dist/

# Strava credentials for the iOS build, and the Info.plist xcodegen writes
ios/Config/Strava.xcconfig
ios/Config/Info.plist
# code-review-graph database and superpowers workspaces (local, rebuilt per session)
.code-review-graph/
.superpowers/

# Films from the owner own phone, scored by run_recognition.py; tests/scenarios/recognition/ names them.
/tests/fixtures/owner/**
