# Android / Gradle
*.iml
.gradle/
.kotlin/
build/
local.properties
.cxx/
captures/
.externalNativeBuild/

# IDE
.idea/
*.hprof

# Keys & secrets — never commit
*.jks
*.keystore
keystore.properties
secrets.properties
*.env

# macOS
.DS_Store

# Swift / SwiftPM
ios/**/.build/
ios/**/.swiftpm/
# Generated by xcodegen from ios/project.yml — regenerate, don't commit
*.xcodeproj
*.xcworkspace

# Large/licensed video-regression datasets and generated reports stay local. Small consented
# local fixtures and keypoint goldens may be committed deliberately.
/tests/fixtures/infiniterep/**
!/tests/fixtures/infiniterep/**/.gitkeep
/tests/fixtures/repcount/**
!/tests/fixtures/repcount/**/.gitkeep
/tests/reports/**
!/tests/reports/.gitkeep

# Third-party clips pulled from YouTube for local regression only. Never committed.
/tests/fixtures/youtube/**
# The manifest is what makes the ignored clips reproducible, so it is tracked.
!/tests/fixtures/youtube/sources.json

# Desktop harness virtualenv and bytecode
.venv/
__pycache__/
*.pyc

# Generated by parity_check.py; trace_jvm.csv is the committed reference.
/tests/parity/trace_py.csv
